+            )
+            assert function_columns == [("0", "0"), ("1", "7"), ("2", "0"), ("3", "0")], (query, function_columns)
+    print(f"PASS: {len(positive)} generic positives, {len(negative)} negatives, comparison AST, lexical nodes and function captures")
